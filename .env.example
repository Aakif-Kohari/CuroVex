# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# PostgreSQL (application data)
POSTGRES_USER=curovex
POSTGRES_PASSWORD=change_me
POSTGRES_DB=curovex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# API
SECRET_KEY=change_me_to_a_random_string
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# ML model & data paths (used by the API to load model at startup)
MODEL_PATH=ml-core/artifacts/gat_link_predictor.pt
DATA_DIR=kg-pipeline/data/normalized

# ML / experiment tracking
MLFLOW_TRACKING_URI=file:./mlruns

# KG pipeline data directory
KG_DATA_DIR=./data/raw

# External validation APIs (no key required, kept here for rate-limit config)
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Error tracking (optional, leave blank until deployed)
SENTRY_DSN=
